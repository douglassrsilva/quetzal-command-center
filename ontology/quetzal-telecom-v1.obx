              "assignment": {
                "entities": [
                  {
                    "ontology_class": "https://quetzal.demo/ontology/Customer",
                    "ontology_class_label": "Customer",
                    "sql_query": "SELECT regexp_extract(subject, '.*/([^/]+)$', 1) AS ID,\n       COALESCE(MAX(CASE WHEN predicate = 'http://www.w3.org/2000/01/rdf-schema#label' THEN object END), regexp_extract(subject, '.*/([^/]+)$', 1)) AS Label,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/baselineChurnProbability', 'https://quetzal.demo/ontology#baselineChurnProbability') THEN object END) AS DOUBLE) AS baseline_churn_probability,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/retentionPriorityScore', 'https://quetzal.demo/ontology#retentionPriorityScore') THEN object END) AS DOUBLE) AS retention_priority_score,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/networkReachScore', 'https://quetzal.demo/ontology#networkReachScore') THEN object END) AS DOUBLE) AS network_reach_score,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/networkExposureScore', 'https://quetzal.demo/ontology#networkExposureScore') THEN object END) AS DOUBLE) AS network_exposure_score\nFROM classic_stable_douglas_s_catalog.quetzal_telecom.gold_quetzal_knowledge_graph_triples\nGROUP BY subject\nHAVING MAX(CASE WHEN predicate = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' AND object IN ('https://quetzal.demo/ontology/Customer', 'https://quetzal.demo/ontology#Customer') THEN 1 ELSE 0 END) = 1",
                    "id_column": "ID",
                    "label_column": "Label",
                    "catalog": "classic_stable_douglas_s_catalog",
                    "schema": "quetzal_telecom",
                    "table": "gold_quetzal_knowledge_graph_triples",
                    "attribute_mappings": {
                      "baselineChurnProbability": "baseline_churn_probability",
                      "retentionPriorityScore": "retention_priority_score",
                      "networkReachScore": "network_reach_score",
                      "networkExposureScore": "network_exposure_score"
                    },
                    "excluded_attributes": [],
                    "description": "Cliente"
                  },
                  {
                    "ontology_class": "https://quetzal.demo/ontology/QualifiedContact",
                    "ontology_class_label": "QualifiedContact",
                    "sql_query": "SELECT regexp_extract(subject, '.*/([^/]+)$', 1) AS ID,\n       COALESCE(MAX(CASE WHEN predicate = 'http://www.w3.org/2000/01/rdf-schema#label' THEN object END), regexp_extract(subject, '.*/([^/]+)$', 1)) AS Label,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/callCount', 'https://quetzal.demo/ontology#callCount') THEN object END) AS BIGINT) AS call_count,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/contactMinutes', 'https://quetzal.demo/ontology#contactMinutes') THEN object END) AS DOUBLE) AS contact_minutes,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/relationshipWeight', 'https://quetzal.demo/ontology#relationshipWeight') THEN object END) AS DOUBLE) AS relationship_weight,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/isReciprocal', 'https://quetzal.demo/ontology#isReciprocal') THEN object END) AS BOOLEAN) AS is_reciprocal,\n       TRY_CAST(MAX(CASE WHEN predicate IN ('https://quetzal.demo/ontology/qualificationReason', 'https://quetzal.demo/ontology#qualificationReason') THEN object END) AS STRING) AS qualification_reason\nFROM classic_stable_douglas_s_catalog.quetzal_telecom.gold_quetzal_knowledge_graph_triples\nGROUP BY subject\nHAVING MAX(CASE WHEN predicate = 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' AND object IN ('https://quetzal.demo/ontology/QualifiedContact', 'https://quetzal.demo/ontology#QualifiedContact') THEN 1 ELSE 0 END) = 1",
