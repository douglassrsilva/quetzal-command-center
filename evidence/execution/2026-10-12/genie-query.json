  "question": "Cuales son los clientes con el mayor potencial de abandono?",
  "generated_sql": "WITH latest_run AS (\n  SELECT run_id, MAX(scored_at) AS max_scored_at\n  FROM classic_stable_douglas_s_catalog.quetzal_telecom.gold_churn_graph_predictions\n  WHERE run_id IS NOT NULL\n  GROUP BY run_id\n  QUALIFY ROW_NUMBER() OVER (ORDER BY max_scored_at DESC, run_id DESC) = 1\n), ranked_customers AS (\n  SELECT\n    CONCAT('***', RIGHT(customer_id, 4)) AS cliente_mascarado,\n    risk_tier,\n    baseline_churn_probability,\n    influenced_revenue_usd,\n    influence_score,\n    contagion_risk_score,\n    high_risk_neighbour_pct,\n    recommended_action,\n    scored_at,\n    RANK() OVER (\n      ORDER BY baseline_churn_probability DESC, influenced_revenue_usd DESC,\n               influence_score DESC, contagion_risk_score DESC\n    ) AS risk_rank\n  FROM classic_stable_douglas_s_catalog.quetzal_telecom.gold_churn_graph_predictions\n  WHERE customer_id IS NOT NULL\n    AND baseline_churn_probability IS NOT NULL\n    AND influenced_revenue_usd IS NOT NULL\n    AND influence_score IS NOT NULL\n    AND contagion_risk_score IS NOT NULL\n    AND run_id = (SELECT run_id FROM latest_run)\n)\nSELECT *\nFROM ranked_customers\nWHERE risk_rank <= 10\nORDER BY risk_rank, baseline_churn_probability DESC,\n         influenced_revenue_usd DESC, influence_score DESC,\n         contagion_risk_score DESC",
